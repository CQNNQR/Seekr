<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Seekr.Avalonia.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ToolbarBackground">#F0F0F0</SolidColorBrush>
                    <SolidColorBrush x:Key="ContentBackground">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarBackground">#F5F5F5</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderBrush">#DDDDDD</SolidColorBrush>
                    <SolidColorBrush x:Key="TextForeground">#000000</SolidColorBrush>
                    <SolidColorBrush x:Key="SecondaryTextForeground">#666666</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonBackground">#E0E0E0</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonForeground">#000000</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ToolbarBackground">#2D2D30</SolidColorBrush>
                    <SolidColorBrush x:Key="ContentBackground">#1E1E1E</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarBackground">#252526</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderBrush">#3E3E42</SolidColorBrush>
                    <SolidColorBrush x:Key="TextForeground">#CCCCCC</SolidColorBrush>
                    <SolidColorBrush x:Key="SecondaryTextForeground">#AAAAAA</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonBackground">#3E3E42</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonForeground">#FFFFFF</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </Application.Styles>
</Application>